# Copy into the app's Secrets box on Streamlit Community Cloud (Settings > Secrets),
# or to .streamlit/secrets.toml for a local test. Never commit the real file.
#
# The camera video goes from the visitor's browser to the server over WebRTC. On a hosted
# copy that needs a TURN server, or the camera stays on "Waiting for video". Free TURN
# accounts: metered.ca (Open Relay) or Twilio Network Traversal. Paste the servers they give you.

[[ice_servers]]
urls = ["stun:stun.l.google.com:19302"]

[[ice_servers]]
urls = ["turn:YOUR_TURN_HOST:80", "turn:YOUR_TURN_HOST:443?transport=tcp"]
username = "YOUR_TURN_USERNAME"
credential = "YOUR_TURN_PASSWORD"
