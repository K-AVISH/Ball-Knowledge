# Copy ONE of the options below into the app's Secrets box on Streamlit Community Cloud
# (My apps > the app's menu > Settings > Secrets), or to .streamlit/secrets.toml for a local
# test. Never commit the real file.
#
# The camera video goes from the visitor's browser to the server over WebRTC. On a hosted
# copy that needs a TURN server, or the camera shows "Connection is taking longer than
# expected". On localhost none of this is needed.

# Option 1 (simplest, free): a Hugging Face access token.
# huggingface.co > sign up > Settings > Access Tokens > Create new token > type "Read".
HF_TOKEN = "hf_YOUR_TOKEN"

# Option 2 (free, larger allowance): a Cloudflare Realtime TURN key.
# dash.cloudflare.com > Realtime > TURN Server > Create. Paste the Turn Token ID and API Token.
# CLOUDFLARE_TURN_KEY_ID = "YOUR_TURN_TOKEN_ID"
# CLOUDFLARE_TURN_KEY_API_TOKEN = "YOUR_API_TOKEN"

# Option 3: any TURN server, listed in full (for example from metered.ca).
# [[ice_servers]]
# urls = ["stun:stun.l.google.com:19302"]
#
# [[ice_servers]]
# urls = ["turn:YOUR_TURN_HOST:80", "turn:YOUR_TURN_HOST:443?transport=tcp"]
# username = "YOUR_TURN_USERNAME"
# credential = "YOUR_TURN_PASSWORD"
