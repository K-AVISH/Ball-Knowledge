+                raise MemeError(str(exc).replace(image.name, upload_name)) from exc
+            raise
+    finally:
+        if tmp_dir is not None:
+            shutil.rmtree(tmp_dir, ignore_errors=True)
+
+
 def describe(library: MemeLibrary) -> str:
     records = library.load()
     if not records:
