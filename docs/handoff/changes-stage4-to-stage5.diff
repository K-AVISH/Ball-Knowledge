+# --- predicting ----------------------------------------------------------------
+
+def test_no_hand_gives_no_hand_without_running_the_model(trained):
+    p = pr.Predictor.load(**paths(trained))
+    out = p.predict(None)
+    assert out.status == pr.NO_HAND
+    assert out.label is None and out.confidence is None and out.top == ()
